# Апстрим-харнесс: клонируется установщиком на закреплённую версию, в этот
# репозиторий не копируется (см. install.sh).
/harness/

# Данные харнесса на конкретной машине: сессии, профили и УЧЁТНЫЕ ДАННЫЕ
# подписки. Не должны попадать в git ни при каких обстоятельствах.
.dsh-data/
.credentials.yaml

# Секреты и локальное окружение
.env
.env.*
!.env.example

# Сборка и зависимости
node_modules/
lib/
lib-test/
dist/
*.tsbuildinfo

# Мусор ОС и редакторов
.DS_Store
*.swp
