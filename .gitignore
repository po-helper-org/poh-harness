# Данные харнесса на конкретной машине: сессии, профили и УЧЁТНЫЕ ДАННЫЕ
# подписки. Не должны попадать в git ни при каких обстоятельствах.
.dsh-data/
.credentials.yaml

# Секреты и локальное окружение
.env
.env.*
!.env.example

# Сборка и зависимости (dsh CLI, профиль, плагины — все ставятся install.sh)
node_modules/
lib/
lib-test/
dist/
*.tsbuildinfo
pnpm-lock.yaml.bak-*

# Мусор ОС и редакторов
.DS_Store
*.swp

# ── Защита от утечек: репозиторий ПУБЛИЧНЫЙ ────────────────────────────────────
# Рабочие данные PO живут только локально. Демо-файлы воркспейса уже в git и
# остаются отслеживаемыми; новые задачи/документы — ваши рабочие, в git не идут
# (добавить новый демо-файл — осознанно: git add -f). Проверка перед коммитом —
# scripts/check-leaks.sh (pre-commit хук, включается install.sh) и CI на PR.
workspace/communication/
workspace/GROUND/PULSE/
workspace/reports/
workspace/sprint-report.config.toml
workspace/sprint-report.lock.json
workspace/backlog/*
!workspace/backlog/config.yml
workspace/bft/documentation/*
*.db
*.db-wal
*.db-shm
*.sqlite
*.bak
*.bak-*
.leakcheck.local

# Локальные индексы и инструменты
.repowise/
.tools/
