# Образец окружения для dsh-plugin-bft.
# Скопируйте в .env и заполните под свою машину: cp .env.example .env
# Файл .env в git не попадает (см. .gitignore) — секреты живут только на машине.
# Ничего секретного в этот образец не дописывайте: здесь только плейсхолдеры.

# ── Обязательное ──────────────────────────────────────────────────────────────

# Корень воркспейса: внутри лежат backlog/ и .bft/. Без него плагин не стартует —
# угадывать чужой воркспейс опаснее, чем упасть сразу.
BFT_WORKSPACE_ROOT=/Users/имя/projects/mts-org/ishmanov-cortex

# ── Необязательное: пути и имена ──────────────────────────────────────────────
# Всё ниже имеет рабочие умолчания, задавайте только если у вас иначе.

# Исполняемый файл Backlog.md. По умолчанию берётся из PATH.
# BFT_BACKLOG_BIN=/opt/homebrew/bin/backlog

# Каталоги относительно корня воркспейса.
# BFT_DOCS_PATH=.bft/documentation
# BFT_INDEX_PATH=.bft/index

# Тип задач Backlog.md, который считается требованием БФТ.
# BFT_TASK_TYPE=bft

# Значение колонки Team в таблице инициатив, которое считается нашей командой.
# BFT_TEAM_NAME=GDS/Платформа

# Таблица продуктовых инициатив — источник синхронизации.
# BFT_INITIATIVES_SHEET_URL=https://docs.google.com/spreadsheets/d/ИДЕНТИФИКАТОР

# ── Необязательное: внешние системы ───────────────────────────────────────────
# Без токенов плагин работает: JIRA и Confluence показываются ссылками.
# Токены нужны только чтобы подтягивать статус эпика и заголовок страницы.

# JIRA_HOST=https://jira.mts.ru
# JIRA_TOKEN=здесь-ваш-персональный-токен

# CONFLUENCE_HOST=https://confluence.mts.ru
# CONFLUENCE_TOKEN=здесь-ваш-персональный-токен
